<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">

    <Frame name="ElitismEPGP_LootQueueRowTemplate" virtual="true">
        <Size x="240" y="26"/>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="itemName" inherits="GameFontHighlightSmall" justifyH="LEFT">
                    <Size x="110" y="14"/>
                    <Anchors><Anchor point="TOPLEFT" x="32" y="-6"/></Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="icon">
                <Size x="24" y="24"/>
                <Anchors><Anchor point="TOPLEFT" x="0" y="0"/></Anchors>
                <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
            </Button>
            <Button parentKey="bidButton" inherits="UIPanelButtonTemplate" text="Bid">
                <Size x="60" y="20"/>
                <Anchors><Anchor point="TOPRIGHT" x="0" y="-3"/></Anchors>
            </Button>
        </Frames>
    </Frame>

    <Frame name="ElitismEPGPLootQueueFrame" parent="UIParent" enableMouse="true" movable="true" hidden="true" frameStrata="MEDIUM">
        <Size x="270" y="120"/>
        <Anchors><Anchor point="TOP" x="0" y="-200"/></Anchors>

        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background-Dark"
                  edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <BackgroundInsets><AbsInset left="11" right="12" top="12" bottom="11"/></BackgroundInsets>
            <TileSize><AbsValue val="32"/></TileSize>
            <EdgeSize><AbsValue val="32"/></EdgeSize>
        </Backdrop>

        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="title" inherits="GameFontNormalLarge" text="Master Loot Queue">
                    <Anchors><Anchor point="TOP" x="0" y="-12"/></Anchors>
                </FontString>
                <FontString parentKey="hint" inherits="GameFontDisableSmall" justifyH="CENTER" text="Epic+ items only.">
                    <Size x="240" y="12"/>
                    <Anchors><Anchor point="BOTTOM" x="0" y="14"/></Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <Button parentKey="closeButton" inherits="UIPanelCloseButton">
                <Anchors><Anchor point="TOPRIGHT" x="-4" y="-4"/></Anchors>
            </Button>
        </Frames>

        <Scripts>
            <OnMouseDown>if button == "LeftButton" then self:StartMoving() end</OnMouseDown>
            <OnMouseUp>self:StopMovingOrSizing(); if ElitismEPGP_LootQueue and ElitismEPGP_LootQueue.SavePos then ElitismEPGP_LootQueue:SavePos() end</OnMouseUp>
        </Scripts>
    </Frame>
</Ui>
